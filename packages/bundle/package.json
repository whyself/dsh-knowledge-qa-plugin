{
  "name": "dsh-knowledge-qa-bundle",
  "version": "0.1.0",
  "description": "DSH product bundle for a fixed-workspace knowledge QA agent",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "knowledge-qa",
    "nova"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tool-policy": {
      "types": "./dist/tool-policy.d.ts",
      "default": "./dist/tool-policy.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/tool-policy.js",
    "dist/tool-policy.d.ts",
    "dist/client.js",
    "cordis.patch.yml",
    "presets/",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter dsh-knowledge-qa-tool-policy build && pnpm --filter dsh-knowledge-qa-ui build && tsc -p tsconfig.build.json && node ../../scripts/assemble-bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whyself/dsh-knowledge-qa-plugin.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/whyself/dsh-knowledge-qa-plugin#readme",
  "bugs": {
    "url": "https://github.com/whyself/dsh-knowledge-qa-plugin/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.5 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent-presets": "link:../../../deepseek-harness/packages/preset/agent-presets",
    "@deepseek-ai/dsh-client-locale": "link:../../../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-runtime": "link:../../../deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../../deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../../../deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-fs": "link:../../../deepseek-harness/packages/fs/fs",
    "@deepseek-ai/dsh-system-prompt": "link:../../../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-workspace": "link:../../../deepseek-harness/packages/workspace/workspace",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "@types/node": "^24.0.0",
    "react": "^18.2.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
